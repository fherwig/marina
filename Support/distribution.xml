<?xml version="1.0" encoding="utf-8"?>
<!-- Per-user install: enable_currentUserHome puts the payload under the home
     directory, so the component's /Applications becomes ~/Applications. The
     other two domains are off, so the installer cannot be talked into a
     system-wide install that would then need an admin password. -->
<installer-gui-script minSpecVersion="2">
    <title>Marina</title>
    <options customize="never" require-scripts="false"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <allowed-os-versions>
        <os-version min="14.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="marina"/>
    </choices-outline>
    <choice id="marina" visible="false">
        <pkg-ref id="org.fherwig.marina.pkg"/>
    </choice>
    <pkg-ref id="org.fherwig.marina.pkg" version="__VERSION__">component.pkg</pkg-ref>
</installer-gui-script>
